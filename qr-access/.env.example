# ═══════════════════════════════════════════════════════════════
#  QR Access Control — Environment Variables
#  Copy this file to .env and fill in your values.
#  On Vercel: add these in Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT ───────────────────────────────────────────────────────────
# Any long random string — keep secret
JWT_SECRET=change-this-to-a-long-random-secret-32chars-minimum

# ── App URL ───────────────────────────────────────────────────────
# The public URL of your deployed site (no trailing slash)
# Used to build QR validation URLs.
APP_URL=https://your-site.vercel.app

# ── Admin setup key ───────────────────────────────────────────────
# Used once to create the first admin via POST /api/admin/setup
# Change this after setup.
ADMIN_SETUP_KEY=change-this-to-a-random-secret-setup-key
